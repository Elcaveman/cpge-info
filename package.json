{
  "name": "my-cpge-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "seo:generate": "node scripts/generate-sitemap.mjs",
    "build": "npm run seo:generate && next build",
    "build:pages": "npm run seo:generate && npx @cloudflare/next-on-pages",
    "lint": "eslint .",
    "preview": "npm run build:pages && wrangler pages dev .vercel/output/static",
    "deploy": "npm run build:pages && wrangler pages deploy .vercel/output/static"
  },
  "dependencies": {
    "next": "^15.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.4.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "wrangler": "^4.87.0"
  }
}
